{
  "name": "agenda-ministerial-simplificada",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "tsx --test tests/data.test.ts tests/versions.test.ts",
    "test:print": "tsx tests/print.ts",
    "pdf:direct": "tsx scripts/pdf/export-direct.ts",
    "pdf:raster": "tsx scripts/pdf/export-raster.ts",
    "test:pdf": "tsx --test tests/pdf.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "~5.9.3",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "playwright": "1.57.0",
    "pdf-lib": "1.17.1",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
